<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Frame Test Viewer — C.Barnickel</title>
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: #2a2018;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  #stage { display: block; width: 100vw; height: 100vh; touch-action: none; }
  #panel {
    position: fixed; top: 14px; left: 14px; z-index: 10;
    background: rgba(15,12,10,0.82); color: #e6d8c4;
    border: 1px solid rgba(201,169,110,0.4); border-radius: 12px;
    padding: 14px 16px; font-size: 13px; line-height: 1.7;
    backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    max-width: 240px;
  }
  #panel h1 { font-size: 14px; margin: 0 0 8px; color: #e6c885; font-weight: 600; letter-spacing: 0.3px; }
  #panel .stat { color: #b8a888; }
  .row { margin-top: 10px; display: flex; gap: 6px; flex-wrap: wrap; }
  button {
    background: rgba(40,32,24,0.9); color: #e6d8c4;
    border: 1px solid rgba(201,169,110,0.35); border-radius: 7px;
    padding: 7px 11px; font-size: 12px; cursor: pointer; transition: all .15s;
    -webkit-tap-highlight-color: transparent;
  }
  button:hover, button.on { color: #1a1410; background: #e6c885; border-color: #e6c885; }
  .swatch { width: 22px; height: 22px; padding: 0; border-radius: 50%; }
  #hint { position: fixed; bottom: 16px; left: 50%; transform: translateX(-50%);
    z-index: 10; color: #b8a888; font-size: 12px; background: rgba(15,12,10,0.7);
    padding: 7px 14px; border-radius: 20px; }
</style>
</head>
<body>
<canvas id="stage"></canvas>
<div id="panel">
  <h1>Frame Test Viewer</h1>
  <div class="stat" id="stats">loading…</div>
  <div class="row" id="colors">
    <button class="swatch on" style="background:#6f8fb7" data-c="6f8fb7" title="Pastel blue"></button>
    <button class="swatch" style="background:#dfe6ea" data-c="dfe6ea" title="Cream"></button>
    <button class="swatch" style="background:#9fb8a7" data-c="9fb8a7" title="Sage"></button>
    <button class="swatch" style="background:#a07b3a" data-c="a07b3a" title="Gilt"></button>
    <button class="swatch" style="background:#141210" data-c="141210" title="Black"></button>
  </div>
  <div class="row">
    <button id="wire">Wireframe</button>
    <button id="spin" class="on">Auto-spin</button>
  </div>
  <div class="row">
    <button id="metal">Metalness</button>
    <button id="bg">BG tone</button>
  </div>
</div>
<div id="hint">drag to rotate · scroll/pinch to zoom · two-finger drag to pan</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/loaders/GLTFLoader.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/controls/OrbitControls.js"></script>
<script>
const GLB_B64 = "";

const canvas = document.getElementById('stage');
const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.setSize(window.innerWidth, window.innerHeight);

const scene = new THREE.Scene();
const bgTones = [0x2a2018, 0x4a352b, 0x1a1a1a, 0xf2efe6];
let bgIdx = 0;
scene.background = new THREE.Color(bgTones[bgIdx]);

const camera = new THREE.PerspectiveCamera(40, window.innerWidth/window.innerHeight, 0.01, 100);
camera.position.set(0, 0.2, 4.2);

const controls = new THREE.OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.08;

// Lighting roughly matching a gallery: warm key spotlight + soft ambient + cool rim
scene.add(new THREE.AmbientLight(0xffffff, 0.55));
const key = new THREE.SpotLight(0xfff1d8, 8, 20, Math.PI/5, 0.5, 1.5);
key.position.set(2, 5, 4);
scene.add(key);
const rim = new THREE.DirectionalLight(0x88aaff, 0.5);
rim.position.set(-3, 1, -2);
scene.add(rim);
const fill = new THREE.DirectionalLight(0xffffff, 0.35);
fill.position.set(0, -2, 3);
scene.add(fill);

let frameMesh = null;
let mat = new THREE.MeshStandardMaterial({ color: 0x6f8fb7, roughness: 0.55, metalness: 0.05 });

// Decode base64 GLB to ArrayBuffer
function b64ToBuffer(b64) {
  const bin = atob(b64);
  const len = bin.length;
  const bytes = new Uint8Array(len);
  for (let i = 0; i < len; i++) bytes[i] = bin.charCodeAt(i);
  return bytes.buffer;
}

const loader = new THREE.GLTFLoader();
loader.parse(b64ToBuffer(GLB_B64), '', (gltf) => {
  const model = gltf.scene;
  let triCount = 0;
  model.traverse(o => {
    if (o.isMesh) {
      o.material = mat;
      o.geometry.computeVertexNormals();
      if (o.geometry.index) triCount += o.geometry.index.count / 3;
      frameMesh = o;
    }
  });
  // Normalize: center + scale so the height ~= 2.6 units, then frame the camera
  const box = new THREE.Box3().setFromObject(model);
  const size = box.getSize(new THREE.Vector3());
  const center = box.getCenter(new THREE.Vector3());
  model.position.sub(center);
  scene.add(model);
  document.getElementById('stats').innerHTML =
    Math.round(triCount).toLocaleString() + ' triangles<br>' +
    'size ' + size.x.toFixed(2) + ' × ' + size.y.toFixed(2) + ' × ' + size.z.toFixed(2);
  // Fit camera to height
  const fitH = size.y * 1.15;
  const dist = (fitH/2) / Math.tan((camera.fov*Math.PI/180)/2);
  camera.position.set(0, 0, dist);
  controls.target.set(0,0,0);
  controls.update();
}, (err) => {
  document.getElementById('stats').textContent = 'load error: ' + err;
});

// Controls
let spin = true;
document.getElementById('spin').onclick = (e) => { spin = !spin; e.target.classList.toggle('on', spin); };
document.getElementById('wire').onclick = (e) => { mat.wireframe = !mat.wireframe; e.target.classList.toggle('on', mat.wireframe); };
let metalOn = false;
document.getElementById('metal').onclick = (e) => {
  metalOn = !metalOn;
  mat.metalness = metalOn ? 0.6 : 0.05;
  mat.roughness = metalOn ? 0.35 : 0.55;
  e.target.classList.toggle('on', metalOn);
};
document.getElementById('bg').onclick = () => {
  bgIdx = (bgIdx + 1) % bgTones.length;
  scene.background = new THREE.Color(bgTones[bgIdx]);
};
document.querySelectorAll('.swatch').forEach(b => {
  b.onclick = () => {
    document.querySelectorAll('.swatch').forEach(s => s.classList.remove('on'));
    b.classList.add('on');
    mat.color.setHex(parseInt(b.dataset.c, 16));
  };
});

function animate() {
  requestAnimationFrame(animate);
  if (spin && frameMesh && frameMesh.parent) frameMesh.parent.rotation.y += 0.005;
  controls.update();
  renderer.render(scene, camera);
}
animate();

window.addEventListener('resize', () => {
  camera.aspect = window.innerWidth/window.innerHeight;
  camera.updateProjectionMatrix();
  renderer.setSize(window.innerWidth, window.innerHeight);
});
</script>
</body>
</html>
